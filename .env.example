# ---------- Server ----------
NODE_ENV=development
PORT=4100
# Public URL of this API (used to build absolute links in emails / sitemap)
API_URL=http://localhost:4100
# Public website URL (certificate links, sitemap, CORS)
SITE_URL=http://localhost:5173
# Comma separated list of origins allowed to call the API (website + admin panel)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ---------- Database ----------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
# Separate from the 2025 stand-in database ("durgotsav") so both can run side by side
DB_NAME=durgotsav_2026
DB_POOL_MAX=10

# Legacy 2025 database, read only by `npm run legacy:import`
LEGACY_DB_NAME=durgotsav
# Folders holding the 2025 photos (uploads/ of the old backend and dist/Album_images)
LEGACY_UPLOADS_DIR=D:/utsav/Durgotsav/backend/uploads
LEGACY_DIST_DIR=D:/utsav/Durgotsav/dist

# ---------- Auth ----------
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=
JWT_EXPIRES_IN=8h
# First super admin created by `npm run db:seed` (change the password after first login)
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@amrutdurgotsav.com
SEED_ADMIN_PASSWORD=

# ---------- Photo album ----------
# Page size for GET /api/images?page=N (and legacy GET /images?page=N)
ALBUM_PAGE_SIZE=20
# Max upload size in MB for participant photos
UPLOAD_MAX_MB=8

# ---------- Registration ----------
# true = ignore the registration window in Admin -> Settings (local testing only)
REGISTRATION_FORCE_OPEN=false

# ---------- Email (certificates) ----------
# Leave SMTP_PASSWORD empty to switch email off (messages are logged instead)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=vivekpatilss23@gmail.com
SMTP_PASSWORD=
MAIL_FROM="AMRUT <vivekpatilss23@gmail.com>"
# Optional: receives a copy of every contact-form enquiry
CONTACT_NOTIFY_EMAIL=

# ---------- SMS ----------
# "log" prints SMS to the server log. Add a provider in src/services/sms.service.js
SMS_DRIVER=log

# ---------- Amazon S3 (participant photos) ----------
# No access keys here: on EC2 the AWS SDK picks up the instance role automatically.
# Set PARTICIPANT_IMAGE_STORAGE=local to keep originals in storage/originals (local dev without AWS).
# Amazon S3 Configuration
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=amrut-durgotsav

# Participant image storage
PARTICIPANT_IMAGE_STORAGE=s3
AWS_S3_PRESIGNED_URL_EXPIRY_SECONDS=300
