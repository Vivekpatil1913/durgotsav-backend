# ---------- Server ----------
NODE_ENV=development
PORT=4100
# Public URL of this API (used to build absolute links in emails / sitemap)
API_URL=http://localhost:4100
# Public website URL (certificate links, sitemap, CORS)
SITE_URL=http://localhost:5173
# Comma separated list of origins allowed to call the API (website + admin panel)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ---------- Database ----------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
# Separate from the 2025 stand-in database ("durgotsav") so both can run side by side
DB_NAME=durgotsav_2026
DB_POOL_MAX=10
# Extra connections for admin analytics (dashboard, district/city statistics), kept apart from public traffic
DB_REPORT_POOL_MAX=2

# Legacy 2025 database, read only by `npm run legacy:import`
LEGACY_DB_NAME=durgotsav
# Folders holding the 2025 photos (uploads/ of the old backend and dist/Album_images)
LEGACY_UPLOADS_DIR=D:/utsav/Durgotsav/backend/uploads
LEGACY_DIST_DIR=D:/utsav/Durgotsav/dist

# ---------- Auth ----------
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=
JWT_EXPIRES_IN=8h
# First super admin created by `npm run db:seed` (change the password after first login)
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@amrutdurgotsav.com
SEED_ADMIN_PASSWORD=

# ---------- Photo album ----------
# Page size for GET /api/images?page=N (and legacy GET /images?page=N)
ALBUM_PAGE_SIZE=20
# Max upload size in MB for participant photos
UPLOAD_MAX_MB=5

# ---------- Registration ----------
# true = ignore the registration window in Admin -> Settings (local testing only).
# Leave false to open/close it from Admin -> Settings -> Force open registration instead.
REGISTRATION_FORCE_OPEN=false

# ---------- Amrut Shivdurg Bhushan Puraskar ----------
# Nomination dates, upload limits and content are edited in Admin → Shivdurg award → Settings.
# true = accept nominations outside the configured window (local testing only; must be false in production)
AWARD_FORCE_OPEN=false
# Evidence files: "local" keeps them in storage/award-documents; "s3" uses AWS_S3_BUCKET_NAME (prefix shivdurg-bhushan/)
AWARD_DOCUMENT_STORAGE=local

# ---------- Email (certificates) ----------
# Leave SMTP_PASSWORD empty to switch email off (messages are logged instead)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=vivekpatilss23@gmail.com
SMTP_PASSWORD=
MAIL_FROM="AMRUT <vivekpatilss23@gmail.com>"
# Optional: receives a copy of every contact-form enquiry
CONTACT_NOTIFY_EMAIL=

# ---------- Background queues: certificate emails, rejection emails, SMS ----------
# Approving a registration queues its certificate email (table certificate_email_jobs) and SMS (sms_messages);
# rejecting one queues the rejection email (registration_emails). Workers render, send and retry them.
# "embedded" = the API runs the workers; "off" = run `npm run certificates:worker` as its own pm2 process
# (recommended in production; several may run at once, each claims different messages).
CERTIFICATE_WORKER=embedded
# Certificates rendered / emailed at once per worker process (also the SMTP connection pool size)
CERTIFICATE_WORKER_CONCURRENCY=4
# Emails per minute per worker process, 0 = no limit. Keep it under the SMTP quota:
# a Gmail account sends about 500 a day (2,000 for Google Workspace) — use Amazon SES or similar for bulk.
CERTIFICATE_EMAIL_RATE_PER_MINUTE=0
# Attempts before an email is marked failed (retried after 1, 5, 15, 60, 180 … minutes)
CERTIFICATE_EMAIL_MAX_ATTEMPTS=6

# ---------- SMS (acknowledgement after registering, certificate link after approval) ----------
# "log" only writes each SMS to the server log (and to sms_messages with status "logged").
# "http" calls your SMS gateway: SMS_HTTP_URL with {phone} (10 digits) and {message} filled in, URL-encoded.
# Put the API key, sender id and DLT template id in the URL, e.g.
#   https://api.example-sms.in/send?apikey=XXXX&sender=AMRUTM&template_id=1207...&to=91{phone}&text={message}
# DLT: register both message texts in src/modules/sms/sms.queue.js as templates, and whitelist the
# SITE_URL domain (the link is SITE_URL/c/<code>).
SMS_DRIVER=log
SMS_HTTP_URL=
SMS_HTTP_METHOD=GET
# Messages per minute per worker process, 0 = no limit (keep it under the gateway's throughput)
SMS_RATE_PER_MINUTE=0
# Attempts before an SMS is marked failed (retried after 1, 5, 15, 60 … minutes)
SMS_MAX_ATTEMPTS=5

# ---------- Load protection ----------
# Registrations processed at once per API process (photo in memory + image work); up to REGISTRATION_QUEUE more wait
# their turn without their upload being read, beyond that the API answers 503 "try again in a few seconds".
REGISTRATION_CONCURRENCY=8
REGISTRATION_QUEUE=200

# ---------- "I am not a robot" (registration form + mobile certificate lookup) ----------
# recaptcha = Google reCAPTCHA v2 "I'm not a robot" checkbox (https://www.google.com/recaptcha/admin, type v2 Checkbox)
# turnstile = Cloudflare Turnstile. Add the website's domain to the key's allowed domains.
# Keys are required in production. Left empty in development, the provider's public TEST keys are used (always passes).
# dummy = development only: a static look-alike checkbox, no Google/Cloudflare script and no keys (any tick passes).
CAPTCHA_PROVIDER=recaptcha
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# ---------- Amazon S3 (participant photos) ----------
# No access keys here: on EC2 the AWS SDK picks up the instance role automatically.
# Set PARTICIPANT_IMAGE_STORAGE=local to keep originals in storage/originals (local dev without AWS).
# Amazon S3 Configuration
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=amrut-durgotsav

# Participant image storage
PARTICIPANT_IMAGE_STORAGE=s3
AWS_S3_PRESIGNED_URL_EXPIRY_SECONDS=300
